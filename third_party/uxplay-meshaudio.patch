 typedef struct raop_conn_s raop_conn_t;
 
+/* Report negotiated sessions, not transient RTSP probes or PCM activity. */
+static void
+meshaudio_session(raop_conn_t *conn, bool active) {
+    if (conn->meshaudio_session_active == active) return;
+    conn->meshaudio_session_active = active;
+    char ip[64] = {0};
+    utils_ipaddress_to_string(conn->remotelen, conn->remote, conn->zone_id, ip, (int) sizeof(ip));
+    logger_log(conn->raop->logger, LOGGER_INFO,
+               "MESHAUDIO_SESSION %s id=%p ip=%s", active ? "connected" : "disconnected", (void *) conn, ip);
+}
+
